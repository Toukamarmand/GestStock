{% extends 'base.html.twig' %}

{% block title %}Hello RapportController!{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 800px;
        width: 95%;
        font: 18px/1.5 sans-serif;
    }

    .example-wrapper code {
        background: #F5F5F5;
        padding: 2px 6px;
    }
</style>

        <div class="pagetitle">
            <h1>Produits épuisés</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Accueil</a></li>
                    <li class="breadcrumb-item">Produits</li>
                    <li class="breadcrumb-item active">Produits épuisés</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title"> Produits épuisés</h4>
                            <table class="table table-bordered">
                                <thead>
                                <tr class="text-center">
                                    <th scope="col" >Désignation</th>
                                    <th scope="col" >Prix Achat</th>
                                    <th scope="col" >Prix Vente</th>
                                    <th scope="col" >Qté Alerte</th>
                                    <th scope="col" >Catégorie</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for ligne in stockEpuiser %}
                                <tr class="text-center">
                                    <td>{{ ligne.designation }}</td>
                                    <td>{{ ligne.prixAchat }}</td>
                                    <td>{{ ligne.prixVente }}</td>
                                    <td>{{ ligne.qteAlerte }}</td>
                                    <td>{{ ligne.categorie.libelle }}</td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        {% endblock %}
