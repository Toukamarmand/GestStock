{% extends 'base.html.twig' %}

{% block title %}Hello RapportController!{% endblock %}

{% block body %}
<style>
    .example-wrapper {
        margin: 1em auto;
        max-width: 800px;
        width: 95%;
        font: 18px/1.5 sans-serif;
    }

    .example-wrapper code {
        background: #F5F5F5;
        padding: 2px 6px;
    }
</style>

        <div class="pagetitle">
            <h1>Rapport sur les ventes</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Accueil</a></li>
                    <li class="breadcrumb-item">Rapport</li>
                    <li class="breadcrumb-item active">Ventes</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title"> Rapport ventes</h4>
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <td colspan="6"></td>
                                    <td>
                                        <form action="{{ path('app_rapport_vente') }}" method="POST" target="_blank">
                                            <button type="submit" name="print" class="btn btn-primary">Imprimer</button>
                                        </form>
                                    </td>
                                </tr>
                                <tr class="text-center">
                                    <th scope="col" >Produits</th>
                                    <th scope="col" >Prix Achat</th>
                                    <th scope="col" >Prix Vente</th>
                                    <th scope="col" >Qte Vendue</th>
                                    <th scope="col" >Stock</th>
                                    <th scope="col" >Montant vente</th>
                                    <th scope="col" >Profit</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for ligne in listeproduit %}
                                <tr class="text-center">
                                    <td>{{ ligne.designation }}</td>
                                    <td>{{ ligne.prixAchat }}</td>
                                    <td>{{ ligne.prixVente }}</td>
                                    <td>{{ ligne.qtevendue }}</td>
                                    <td>{{ ligne.qtecommande }}</td>
                                    <td>{{ ligne.montantvente }}</td>
                                    <td>{#{{ ligne.profit }}#}</td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer"> <a href="#" class="btn btn-primary ml-4">Imprimer</a></div>
                    </div>
                </div>
            </div>
        </section>
        {% endblock %}
