<script>
    toastr.options={
        "closeButton":true,
        "progressBar":true,
        "positionClass":"toast-top-right",
        "timeOut":"5000",
        "extendedTimeOut":"1000"
    };
    /*export function showToast(type,message){
        toastr[type](message);
    }*/
</script>
<script>
    {# On recupere le chemin du controller json #}
    fetch('{{ path('app_ajaxNbreProduitEpuiser') }}',{
        {# On passe la methode en Get #}
        method:'GET',
        {# On rend le message ou la reponse asynchrone #}
    }).then(async reponse=>{
        try {
            {# On recupere la reponse  #}
            const data=await reponse.json();
            {# on passe la reponse a notre element dans le html e.g:Notre card ou notre span etc #}
            $('#stockEpuiser').text(data);
        }catch (reason){
            console.log(reason);
        }
    }).catch(function (reason){
        console.log(reason)
    })
</script>
