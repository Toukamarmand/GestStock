<script>
    document.addEventListener('DOMContentLoaded',function (){
        {% for type,messages in app.flashes %}
        {% for message in messages %}
        {% if(type=='success') %}
        toastr.success('{{ message }}');
        {%  elseif type=='danger' %}
        toastr.error('{{ message }}');
        {%  elseif type=='warning' %}
        toastr.warning('{{ message }}');
        {%  elseif type=='info' %}
        toastr.info('{{ message }}');
        {% endif %}
        {% endfor %}
        {% endfor %}
    })
</script>
