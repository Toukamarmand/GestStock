    <h1>Hello {{ controller_name }}! ✅</h1>

    <ul>
        <li><a href="{{ path('app_categorie') }}">Liste des categories</a></li>
        <li><a href="{{ path('app_produit') }}">Liste des produits</a></li>
        <li><a href="{{ path('app_categorie_ajout') }}">Ajouter une categorie</a></li>
        <li><a href="{{ path('app_produit_ajout') }}">Ajouter un produit</a></li>
    </ul>
    <table class="table table-bordered">
        <caption>Liste des produits</caption>
        <tr class="gras">
            <td class="gris">ID</td>
            <td class="gris">Libelle</td>
        </tr>
        {% for categorie in categories %}
        <tr class="gras">
            <td class="gris">{{ categorie.id }}</td>
            <td class="gris">{{ categorie.libelle|upper }}
                <!-- Pour compter le nombre de produits d'une categorie-->
               ( {{ categorie.produits.count }} produits)
            </td>
        </tr>
        {% endfor %}
</div>#}
        <div class="pagetitle">
            <h1>Liste des utilisateurs</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Accueil</a></li>
                    <li class="breadcrumb-item">utilisateurs</li>
                    <li class="breadcrumb-item active">Données</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->

        <section class="section">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">Liste des utilisateurs</h4>

                            <!-- Table with stripped rows -->
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <td colspan="2"></td>
                                    <td class="text-center">
                                        <div class="col-lg-2"></div>
                                        <div class="col-lg-8">
                                            <form action="">
                                                <input type="text" class="form-control" placeholder="Rechercher" id="searchInput">
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="col">Login</th>
                                    <th scope="col">Mot de passe</th>
                                    <th scope="col">Role</th>
                                    <th scope="col">Action</th>
                                </tr>
                                </thead>
                                <tbody>

                                {% for user in users %}
                                    <tr class="font-weight-bold valeur">
                                        <td class="gris">{{ user.userName }}</td>
                                        <td class="gris">{{ user.password }}</td>
                                        <td class="gris">{{ user.role|upper }}
                                            <!-- Pour compter le nombre de produits d'une categorie-->
                                        </td>
                                        <td class="gris">
                                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#{{ user.id }}"><i class="ri-delete-bin-5-line"> Supprimer</i></button>
                                            <a href="{{ path('app_user_editer',{id: user.id}) }}"
                                               class="btn btn-primary"><i class="ri-edit-box-line">Modifier</i></a>


                                            <div class="modal fade" id="{{ user.id }}" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Supprimer un utilisateur</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Voulez vous supprimer l'utilisateur {{ user.userName }}
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                            <a href="{{ path('app_user_supprimer',{id: user.id}) }}"
                                                               class="btn btn-danger"><i class="ri-delete-bin-5-line">Supprimer</i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>


{% endblock %}
{% block javascripts %}

    <script>
        $(document).ready(function (){
            $('#searchInput').on("keyup",function (){
                var value=$(this).val().toLowerCase();
                $(".valeur").filter(function (){
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                })
            })
        })
    </script>
{% endblock %}
