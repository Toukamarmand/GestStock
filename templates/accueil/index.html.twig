{% extends 'base.html.twig' %}

{% block title %}Hello AccueilController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
    <div class="pagetitle">
        <h1>Dashboard</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_accueil') }}">Home</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->
<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-12">
            <div class="row">
                <div class="col-xxl-4 col-md-4">
                    <div class="card info-card sales-card">



                        <div class="card-body">
                            <h5 class="card-title">Produit <span>| Nbre Produits</span></h5>

                            <a href="">
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-cart4"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>{{ nbreproduit }}</h6>
                                        <span  class="text-muted small pt-2 ps-1 fw-bold"> Produits <br></span>
                                    </div>
                                </div>
                            </a>
                        </div>

                    </div>
                </div><!-- End Sales Card -->

                <div class="col-xxl-4 col-md-4">
                    <div class="card info-card sales-card">



                        <a href="">
                        <div class="card-body">
                            <h5 class="card-title">Commande <span>| Nombre commandes</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="ri-shopping-cart-fill"></i>
                                </div>
                                <div class="ps-3">
                                    <h6> {{ commande}} </h6>
                                    <span  class="text-muted small pt-2 ps-1 fw-bold"> Commandes</span> <span class="text-success small pt-1 fw-bold"></span>
                                </div>
                            </div>
                        </div>
                        </a>
                    </div>
                </div>


                <div class="col-xxl-4 col-md-4">
                    <div class="card info-card sales-card">


                        <a href="#">
                            <div class="card-body">
                                <h5 class="card-title">Commandes <span>| Commandes validées</span></h5>

                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-cart-check-fill p-1"></i>
                                    </div>
                                    <div class="ps-3">
                                        {% for cmd in valider %}
                                        <h6> {{ cmd.valider}} </h6>
                                        {% endfor %}
                                        <span class="text-muted small pt-2 ps-1 fw-bold"></span> Commandes<span class="text-success small pt-1 fw-bold"> validées</span>

                                    </div>
                                </div>
                            </div>
                        </a>

                    </div>
                </div><!-- End Sales Card -->

                <div class="col-xxl-4 col-md-4">
                    <div class="card info-card revenue-card">



                            <div class="card-body">
                                <h5 class=" card-title">Comndes <span>| Commandes non Validées</span> </h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon bg-information rounded-circle d-flex align-items-center justify-content-center text-danger">
                                        <i class="bi bi-cart-x-fill"></i>
                                    </div>
                                    <div class="ps-3">
                                        {% for cmd in Nonvalider %}
                                            <h6> {{ cmd.Nonvalider}} </h6>
                                        {% endfor %}
                                        <span  class="text-muted small pt-2 ps-1 fw-bold">Commandes</span> <span class="text-danger small pt-1 fw-bold"> non Validées</span>
                                    </div>
                                </div>
                            </div>


                    </div>
                </div>

                <!-- Revenue Card -->
                <div class="col-xxl-4 col-md-4">
                    <div class="card info-card revenue-card">



                        <div class="card-body">
                            <h5 class="card-title">Ventes <span>| Ventes enregistrées </span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-cart-plus-fill"></i>
                                </div>
                                <div class="ps-3">

                                    <h6>{{ vente}} </h6>

                                    <span  class="text-muted small pt-2 ps-1 fw-bold">Ventes</span>

                                </div>
                            </div>
                        </div>

                    </div>
                </div><!-- End Revenue Card -->

                <div class="col-xxl-4 col-md-4">
                    <div class="card info-card sales-card">

                        <div class="filter">
                            <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <li class="dropdown-header text-start">
                                    <h6>Filter</h6>
                                </li>

                                <li><a class="dropdown-item" href="#">Today</a></li>
                                <li><a class="dropdown-item" href="#">This Month</a></li>
                                <li><a class="dropdown-item" href="#">This Year</a></li>
                            </ul>
                        </div>
                        {% set montantTotal=0 %}
                        {% set montant=0 %}
                        {% for prof in profit %}
                            {% set montant= (prof.prixVente - prof.prixAchatMoyen) * prof.qtecommander %}
                            {% set montantTotal=+montant %}
                        {% endfor %}
                        <div class="card-body">
                            <h5 class="card-title"> Profit <span>| Benefices</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-cash-coin"></i>
                                </div>
                                <div class="ps-3">

                                    <h6> {{ profit }}</h6><span class="text-success small pt-1 fw-bold">FCFA</span>

                                    {#  #}
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Produits vendus recemment</h5>
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <th scope="col">Produit</th>
                                    <th scope="col">Nbre Vente</th>
                                    <th scope="col">Prix Vente</th>
                                    <th scope="col">Categorie</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for produit in produitrecent %}
                                <tr class="font-weight-bold text-center ">
                                    <td class="gris">{{ produit.designation }}</td>
                                    <td class="gris">{{ produit.vente }}</td>
                                    <td class="gris">{{ produit.PV }}</td>
                                    <td class="gris">{{ produit.libelle }}</td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Produit par Categorie</h5>
                            <canvas id="produitchart" style="max-height: 400px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Commandes effectuées recemment</h5>
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <th scope="col">Code commande</th>
                                    <th scope="col">Nbre de produit</th>
                                    <th scope="col">Date commande</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for commande in commanderecente %}
                                    <tr class="font-weight-bold text-center ">
                                        <td class="gris">{{ commande.code }}</td>
                                        <td class="gris">{{ commande.commande }}</td>
                                        <td class="gris">{{ commande.date|dateformatFr }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card">

                        {# FILTRE PAR PERIODE #}
                        <div class="filter">
                            <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <li class="dropdown-header text-start">
                                    <h6>Filter</h6>
                                </li>

                                <li><a class="dropdown-item" href="{{ path('app_accueil',{id:0}) }}">Ajourd'hui</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_accueil',{id:1}) }}">Ce mois</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_accueil',{id:2}) }}">Cette année</a></li>
                            </ul>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">Rapport commande par date</h5>
                            <canvas id="commandechart" style="max-height: 400px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
{% block javascripts %}
    <script src="assets/vendor/chart.js/chart.umd.js"></script>
        <script>
            let produit=[];
            {% for prod in produitParCategorie %}
            produit.push({
                nbreproduit:{{ prod.nbProduit }},
                categorie:'{{ prod.libel }}'
            });
            {% endfor %}


            console.log(produit);
            document.addEventListener("DOMContentLoaded", () => {
            new Chart(document.querySelector('#produitchart'), {
                type: 'bar',
                data: {
                    labels:produit.map(prod=>prod.categorie),
                    datasets: [{
                        label: 'Nbre produits',
                        data: produit.map(prod=>prod.nbreproduit),
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.2)',
                            'rgba(255, 159, 64, 0.2)',
                            'rgba(255, 205, 86, 0.2)',
                            'rgba(75, 192, 192, 0.2)',
                            'rgba(54, 162, 235, 0.2)',
                            'rgba(153, 102, 255, 0.2)',
                            'rgba(201, 203, 207, 0.2)'
                        ],
                        borderColor: [
                            'rgb(255, 99, 132)',
                            'rgb(255, 159, 64)',
                            'rgb(255, 205, 86)',
                            'rgb(75, 192, 192)',
                            'rgb(54, 162, 235)',
                            'rgb(153, 102, 255)',
                            'rgb(201, 203, 207)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
    <!-- End Bar CHart -->
    <script>
        let commannde=[];
        {% for commande in commandepardate %}
        commannde.push({
            nbrecommande:{{ commande.nbrecommande }},
            date:'{{ commande.date|date('Y-m-d') }}'
        });
        {% endfor %}
        console.log(commannde);
        document.addEventListener("DOMContentLoaded", () => {
            new Chart(document.querySelector('#commandechart'), {
                type: 'line',
                data: {
                    labels: commannde.map(commande=>commande.date),
                    datasets: [{
                        label: 'Nbre commande',
                        data:commannde.map(commande=>commande.nbrecommande),
                        fill: false,
                        borderColor: 'rgb(75, 192, 192)',
                        tension: 0.1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}
