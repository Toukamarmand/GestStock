    <div class="pagetitle">
        <h1>Ajouter un Produit</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Accueil</a></li>
                <li class="breadcrumb-item">Produit</li>
                <li class="breadcrumb-item active">Données</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->
    <section class="section p-4">
        <div class="row">
            <div class="col-lg-3"></div>
            <div class="col-lg-6">
                <div class="card ">
                    <div class="card-body ">
                        <h3 class="card-title text-center text-success font-weight-bold gras">{{ 'produit.ajout.titre'|trans }}</h3>
                        {# Debut du formulaire #}
                        {{ form_start(form) }}
                        {% if errors!=[] %}
                            <div class="alert alert-danger">
                                <ul>
                                    {% for erreur in errors %}
                                        <li>{{ erreur.message }}</li>
                                    {% endfor %}

                                </ul>
                            </div>
                        {%  endif %}
                        {{ form_widget(form) }}
                        <br>
                        <button type="submit" class="btn btn-light btn-outline-success p-2 form-control"><i class="ri-save-2-fill"> Enregistrer </i></button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>


{% endblock %}
