{% extends 'base.html.twig' %}

{% block title %}Hello ProduitController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
{#
<div class="example-wrapper">
    <ul>
        <li><a href="{{ path('app_categorie') }}">Liste des categories</a></li>
        <li><a href="{{ path('app_produit') }}">Liste des produits</a></li>
        <li><a href="{{ path('app_categorie_ajout') }}">Ajouter une categorie</a></li>
        <li><a href="{{ path('app_produit_ajout') }}">Ajouter un produit</a></li>
    </ul>
  {{ form_start(form) }}
