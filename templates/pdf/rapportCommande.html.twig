<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport commandes</title>
    <style type="text/css" media="all">
        {% include ('pdf/css.html.twig') %}
    </style>
</head>
<body>
<main id="main" class="main">
    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title"> Rapport commandes</h4>
                        <table class="table table-bordered">
                            <thead>
                           {# <tr>
                                <th scope="col"colspan="3"></th>
                                <th scope="col" colspan="4">
                                    <form action="{{ path('app_commande_liste') }}">
                                        <input type="date" name="debut"  value="{{ debut|date('Y-m-d') }}"  >
                                        <input type="date" name="fin" value="{{ fin|date('Y-m-d')}}">
                                        <button type="submit" class="btn btn-primary">Rechercher</button>
                                    </form>
                                </th>
                            </tr>#}
                            <tr class="text-center">
                                <th scope="col" >Produits</th>
                                <th scope="col" >Prix Achat</th>
                                <th scope="col" >Qte Commandée</th>
                                <th scope="col" >Stock</th>
                                <th scope="col" >Montant commande</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for ligne in listeproduit %}
                                <tr class="text-center">
                                    <td>{{ ligne.designation }}</td>
                                    <td>{{ ligne.prixAchatMoyen }}</td>
                                    <td>{{ ligne.qtecommander}}</td>
                                    <td>{{ ligne.qtecommande }}</td>
                                    <td>{{ ligne.montantcommande }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
            </div>
        </div>
    </section>
</main>
</body>