                    </a>
                </li>
                <li>
                    <a href="{{ path('app_rapport_commande') }} " class="{% if page == 'app_rapport_commande' %} active {% endif %}" >
                        <i class="bi bi-circle"></i><span>Rapport sur les commandes</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="bi bi-circle"></i><span>Liste des utilisateurs</span>
                    </a>
                </li>
            </ul>
        </li><!-- End rapport Nav -->
        {% endif %}

        <li class="nav-item">
            <a class="nav-link collapsed" data-bs-target="#icons-nav" data-bs-toggle="collapse" href="#">
